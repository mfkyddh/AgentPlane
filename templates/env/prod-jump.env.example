# Copy to secrets/env/prod-jump.env and fill with real values.
export PROD_LABEL='0号生产机（主力）'
export PROD_HOST=REPLACE_WITH_PRIMARY_IP
export PROD_PORT=22
export PROD_USER=ubuntu
export PROD_DOMAIN=REPLACE_WITH_PRIMARY_DOMAIN
export PROD_SSH_KEY=<repo-root>/secrets/ssh/keys/prod0-main.pem
export PROJECT_SSH_CONFIG=<repo-root>/secrets/ssh/config

export PROD_BACKUP_LABEL='1号生产机（备用）'
export PROD_BACKUP_HOST=REPLACE_WITH_BACKUP_IP
export PROD_BACKUP_PORT=22
export PROD_BACKUP_USER=ubuntu
export PROD_BACKUP_DOMAIN=REPLACE_WITH_BACKUP_DOMAIN
export PROD_BACKUP_SSH_KEY=<repo-root>/secrets/ssh/keys/prod1-backup.pem

export REMOTE_APP_DIR=/data/apps/your-app
export DEPLOY_PROJECT_NAME=your-project-name
export KEEP_RELEASES=5
export FRONTEND_DEPLOY_MODE=cloudflare-pages
export PUBLIC_BASE_URL=https://replace-with-api.example.com
export PUBLIC_FRONTEND_URL=https://replace-with-admin.example.com
export NGINX_UI_BASE_URL=https://replace-with-nginx-ui.example.com/
export APP_HEALTH_URL=http://127.0.0.1:8080/health
export PUBLIC_API_PATH=/api/health
export CLOUDFLARE_PAGES_PROJECT_NAME=replace-with-pages-project
export CLOUDFLARE_PAGES_BRANCH=main
export CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
export CLOUDFLARE_API_TOKEN=replace-with-api-token
export REMOTE_USE_SUDO_SERVER=true
export REMOTE_USE_SUDO_DOCKER=auto
