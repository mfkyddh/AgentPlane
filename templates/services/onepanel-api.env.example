# Copy to secrets/services/onepanel-api.env.
ONEPANEL_BASE_URL=https://1panel.example.com:8443
ONEPANEL_CONNECT_BASE_URL=http://127.0.0.1:2096
ONEPANEL_API_KEY=replace-with-1panel-api-key
ONEPANEL_SECURITY_ENTRANCE=replace-with-security-entrance
ONEPANEL_TIMEOUT_MS=30000
ONEPANEL_SKIP_TLS_VERIFY=false
