# Copy to secrets/services/sub2apipay.wsl.env and replace placeholders as needed.
TZ=Asia/Shanghai
NODE_ENV=development
HOSTNAME=0.0.0.0
PORT=3000

DATABASE_URL=postgresql://sub2apipay_wsl:<postgres_password>@postgres18-dev:5432/sub2apipay_dev

SUB2API_BASE_URL=http://127.0.0.1:18080
SUB2API_ADMIN_API_KEY=<replace-with-local-sub2api-admin-api-key>
ADMIN_TOKEN=<replace-with-random-secret>

NEXT_PUBLIC_APP_URL=http://127.0.0.1:18091
IFRAME_ALLOW_ORIGINS=http://127.0.0.1:18080

PAYMENT_PROVIDERS=easypay
ENABLED_PAYMENT_TYPES=alipay,wxpay

EASY_PAY_PID=<replace-with-dev-pid>
EASY_PAY_PKEY=<replace-with-dev-private-key>
EASY_PAY_API_BASE=https://zpayz.cn
EASY_PAY_NOTIFY_URL=http://127.0.0.1:18091/api/easy-pay/notify
EASY_PAY_RETURN_URL=http://127.0.0.1:18091/pay/result

ORDER_TIMEOUT_MINUTES=5
MIN_RECHARGE_AMOUNT=1
MAX_RECHARGE_AMOUNT=10000
MAX_DAILY_RECHARGE_AMOUNT=0
PRODUCT_NAME=Sub2API Balance Recharge
