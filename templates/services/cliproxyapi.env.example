# Copy the deployment values you want to override to secrets/services/cliproxyapi.wsl.env or secrets/services/cliproxyapi.prod0.env.
# Keep live secrets in /data/cliproxyapi/config/config.yaml instead of this file.
CLI_PROXY_IMAGE=eceasy/cli-proxy-api:v6.9.10@sha256:39bbf82385e42cdb440e9bededa2666dbc765a864af0014d88d54720be3fa92e
CLI_PROXY_CONTAINER_NAME=cli-proxy-api-dev
CLI_PROXY_BIND_IP=0.0.0.0
CLI_PROXY_API_PORT=8318
CLI_PROXY_GEMINI_CALLBACK_PORT=21455
CLI_PROXY_CODEX_CALLBACK_PORT=54545
CLI_PROXY_QWEN_CALLBACK_PORT=51121
CLI_PROXY_IFLOW_CALLBACK_PORT=11451
CLI_PROXY_DATA_ROOT=/data/cliproxyapi
CLI_PROXY_CONFIG_PATH=/data/cliproxyapi/config/config.yaml
