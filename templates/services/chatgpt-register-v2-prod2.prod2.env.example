# Copy to secrets/services/chatgpt-register-v2-prod2.prod2.env.
# Business import config comes from the image-baked config/private/prod2.json.
# The image default entrypoint already fixes prod2 + sub2api-local + workers=5 + interval=3 + mail-wait=300.
# Override only with a compose command when you need temporary local tuning.
TZ=Asia/Shanghai
PYTHONUNBUFFERED=1
