# Copy to secrets/services/newapi.wsl.env and replace placeholders as needed.
TZ=Asia/Shanghai
SQL_DSN=postgresql://newapi_wsl:<postgres_password>@postgres18-dev:5432/newapi_wsl?sslmode=disable
REDIS_CONN_STRING=redis://:<redis_password>@redis7-dev:6379/2
SESSION_SECRET=<replace-with-random-secret>
CRYPTO_SECRET=<replace-with-random-secret>
ERROR_LOG_ENABLED=true
MEMORY_CACHE_ENABLED=true
