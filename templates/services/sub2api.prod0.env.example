# Copy to secrets/services/sub2api.prod0.env and replace placeholders.
TZ=Asia/Shanghai
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=release
RUN_MODE=standard
DATA_DIR=/app/data
DATABASE_HOST=postgres18-prod
DATABASE_PORT=5432
DATABASE_USER=sub2api_prod0
DATABASE_PASSWORD=change_me
DATABASE_DBNAME=sub2api_prod0
DATABASE_SSLMODE=disable
DATABASE_MAX_OPEN_CONNS=48
DATABASE_MAX_IDLE_CONNS=16
REDIS_HOST=redis7-prod
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_ENABLE_TLS=false
# REDIS_USER is not projected for prod0-main runtime.
JWT_SECRET=change_me
TOTP_ENCRYPTION_KEY=change_me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
PRICING_DATA_DIR=/app/data/pricing
PRICING_FALLBACK_FILE=/app/resources/model-pricing/model_prices_and_context_window.json
SORA_STORAGE_LOCAL_PATH=/app/data/sora
