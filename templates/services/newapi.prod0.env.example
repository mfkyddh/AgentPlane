# Copy to secrets/services/newapi.prod0.env and replace placeholders.
TZ=Asia/Shanghai
SQL_DSN=postgresql://newapi_prod0:<urlencoded-postgres-password>@postgres18-prod:5432/newapi_prod0?sslmode=disable
DATABASE_URL=postgres://newapi_prod0:<urlencoded-postgres-password>@postgres18-prod:5432/newapi_prod0
REDIS_CONN_STRING=redis://:<urlencoded-redis-password>@redis7-prod:6379/2
REDIS_URL=redis://:<urlencoded-redis-password>@redis7-prod:6379/2
SESSION_SECRET=<replace-with-random-secret>
CRYPTO_SECRET=<replace-with-random-secret>
ERROR_LOG_ENABLED=true
MEMORY_CACHE_ENABLED=true
