# Optional manual browser-login helper.
# This file is outside the bootstrap/takeover contract and is only for flows
# that still need a human to sign into 1Panel in a browser.
# Copy to secrets/services/onepanel-login.<target>.env and fill real values.
ONEPANEL_LOGIN_URL=https://1panel.example.com/
ONEPANEL_USERNAME=replace-with-onepanel-username
ONEPANEL_PASSWORD=replace-with-onepanel-password
