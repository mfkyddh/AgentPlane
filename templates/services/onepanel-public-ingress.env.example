# Copy to secrets/services/onepanel-public-ingress.<target>.env and fill with real values.
PUBLIC_INGRESS_DOMAIN=1panel.example.com
PUBLIC_INGRESS_ZONE_NAME=example.com
PUBLIC_INGRESS_RECORD_TYPE=A
PUBLIC_INGRESS_RECORD_CONTENT=203.0.113.10
PUBLIC_INGRESS_RECORD_PROXIED=true

ONEPANEL_DNS_ACCOUNT_NAME=cloudflare-example
ONEPANEL_DNS_ACCOUNT_PROVIDER=CloudFlare
ONEPANEL_DNS_ACCOUNT_EMAIL=admin@example.com

ONEPANEL_ACME_EMAIL=acme@example.com
ONEPANEL_ACME_TYPE=letsencrypt
ONEPANEL_ACME_KEY_TYPE=2048

ONEPANEL_WEBSITE_ALIAS=panel
ONEPANEL_WEBSITE_TYPE=proxy
ONEPANEL_WEBSITE_GROUP_ID=1
ONEPANEL_WEBSITE_PROXY=http://127.0.0.1:2096
ONEPANEL_WEBSITE_REMARK=public ingress managed by AgentPlane
ONEPANEL_WEBSITE_IPV6=true

ONEPANEL_CERT_PRIMARY_DOMAIN=1panel.example.com
ONEPANEL_CERT_OTHER_DOMAINS=
ONEPANEL_CERT_DIR=/data/1panel/www/certs/1panel-example-com
ONEPANEL_CERT_DESCRIPTION=public ingress managed by AgentPlane
ONEPANEL_CERT_KEY_TYPE=2048
ONEPANEL_CERT_AUTO_RENEW=true
ONEPANEL_CERT_RELOAD_SHELL=docker exec 1panel-openresty-prod nginx -t && docker exec 1panel-openresty-prod nginx -s reload

ONEPANEL_HTTPS_HTTP_CONFIG=HTTPAlso
ONEPANEL_HTTPS_PORTS=443
