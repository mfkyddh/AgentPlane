# Copy to /data/cliproxyapi/config/config.yaml and replace the placeholders.
# In the repository-managed Docker deployment, the host publishes 0.0.0.0:8318
# and current CLIProxyAPI releases also listen on 8318 inside the container.
# The management page is served from the same HTTP listener via /management.html.
host: ""
port: 8318
tls:
  enable: false
  cert: ""
  key: ""
remote-management:
  allow-remote: true
  secret-key: "REPLACE_WITH_BCRYPT_HASH"
  disable-control-panel: false
  panel-github-repository: "https://github.com/router-for-me/Cli-Proxy-API-Management-Center"
auth-dir: "/root/.cli-proxy-api"
api-keys:
  - "REPLACE_WITH_CLIENT_API_KEY"
debug: false
pprof:
  enable: false
  addr: "127.0.0.1:8316"
commercial-mode: false
logging-to-file: true
logs-max-total-size-mb: 100
error-logs-max-files: 20
usage-statistics-enabled: true
proxy-url: "http://172.25.240.1:7890"
force-model-prefix: false
passthrough-headers: false
request-retry: 3
max-retry-credentials: 0
max-retry-interval: 30
quota-exceeded:
  switch-project: true
  switch-preview-model: true
routing:
  strategy: "round-robin"
ws-auth: false
