# Copy to secrets/services/chatgpt-register-v2.wsl.env or secrets/services/chatgpt-register-v2.prod0.env.
# Business secrets and runtime knobs live in an external full config JSON referenced by CHATGPT_REGISTER_CONFIG_HOST_PATH.
# Suggested paths:
#   WSL   -> <repo-root>/secrets/services/chatgpt-register-v2.wsl.config.json
#   prod0 -> /opt/agentplane/secrets/services/chatgpt-register-v2.prod0.config.json
CHATGPT_REGISTER_V2_IMAGE_REF=chatgpt-register-v2-prod:latest
CHATGPT_REGISTER_V2_BUILD_CONTEXT=/root/work/chatgpt_register_v2_by_AI
CHATGPT_REGISTER_V2_DOCKERFILE=Dockerfile
UV_BUILD_INDEX=https://pypi.org/simple
BUILD_PROXY=
NO_PROXY=127.0.0.1,localhost,::1
TZ=Asia/Shanghai
PYTHONUNBUFFERED=1
CHATGPT_REGISTER_CONFIG_HOST_PATH=/opt/agentplane/secrets/services/chatgpt-register-v2.prod0.config.json
CHATGPT_REGISTER_CONFIG_PATH=/run/chatgpt-register/config/active.json
CHATGPT_REGISTER_PROFILE=prod0
CHATGPT_REGISTER_IMPORT_TARGET=sub2api-local
CHATGPT_REGISTER_WORKERS=1
CHATGPT_REGISTER_INTERVAL=60
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=18081
