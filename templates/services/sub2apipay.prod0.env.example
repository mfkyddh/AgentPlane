# Copy to secrets/services/sub2apipay.prod0.env and replace placeholders.
TZ=Asia/Shanghai
NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000

DATABASE_URL=postgresql://sub2apipay_prod0:<urlencoded-postgres-password>@postgres18-prod:5432/sub2apipay

SUB2API_BASE_URL=https://token.zzzai.cloud:8443
SUB2API_ADMIN_API_KEY=<replace-with-sub2api-admin-api-key>
ADMIN_TOKEN=<replace-with-random-secret>

NEXT_PUBLIC_APP_URL=https://pay.zzzai.cloud:8443
IFRAME_ALLOW_ORIGINS=https://token.zzzai.cloud:8443

PAYMENT_PROVIDERS=easypay
ENABLED_PAYMENT_TYPES=alipay,wxpay

EASY_PAY_PID=<replace-with-easypay-pid>
EASY_PAY_PKEY=<replace-with-easypay-private-key>
EASY_PAY_API_BASE=https://www.ezfpy.cn
EASY_PAY_NOTIFY_URL=https://pay.zzzai.cloud:8443/api/easy-pay/notify
EASY_PAY_RETURN_URL=https://pay.zzzai.cloud:8443/pay/result

ORDER_TIMEOUT_MINUTES=5
MIN_RECHARGE_AMOUNT=1
MAX_RECHARGE_AMOUNT=10000
MAX_DAILY_RECHARGE_AMOUNT=0
PRODUCT_NAME=Sub2API Balance Recharge
