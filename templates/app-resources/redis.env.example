# Copy to secrets/app-resources/<target>/<app>/redis.env.
REDIS_HOST=replace-with-redis-host
REDIS_PORT=6379
# Historical metadata only on prod0-main. Do not treat this as part of the
# canonical DB-isolation contract or render-time managed fields.
REDIS_USER=replace-with-legacy-redis-user
# On prod0-main this is the shared Redis runtime password, not a per-tenant unique password.
REDIS_PASSWORD=replace-with-shared-runtime-password
# Canonical prod0-main formal registry entries keep REDIS_DB as an integer allocation.
REDIS_DB=replace-with-redis-db
# Canonical prod0-main formal registry entries keep REDIS_KEY_PREFIX normalized with a trailing colon.
REDIS_KEY_PREFIX=replace-with-key-prefix
REDIS_ENABLE_TLS=false
