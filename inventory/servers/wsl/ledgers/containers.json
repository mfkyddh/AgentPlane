{
  "items": [
    {
      "container_name": "chatgpt-register-v2-dev",
      "service_key": "chatgpt-register-v2"
    },
    {
      "control_plane": "compose",
      "container_name": "sub2api-dev",
      "depends_on_containers": [
        "postgres18-dev",
        "redis7-dev"
      ],
      "runtime_root": "/data/sub2api/app/current",
      "config_files": [
        "/root/work/AgentPlane/secrets/services/sub2api.wsl.env"
      ],
      "data_dir": "/data/sub2api/data",
      "host_binding": "0.0.0.0:18080",
      "container_port": 8080,
      "public_url": "http://127.0.0.1:18080",
      "rollback_entry": {
        "kind": "none",
        "note": "wsl dev target 无独立旧控制面"
      },
      "docker_networks": [
        "zqf_network"
      ],
      "app_resource_summary": {
        "postgres": {
          "database": "sub2api_wsl",
          "user": "sub2api_wsl",
          "secret_file": "secrets/hosts/wsl/apps/sub2api/resources/postgres.env"
        },
        "redis": {
          "db": 1,
          "key_prefix": "sub2api:wsl:",
          "secret_file": "secrets/hosts/wsl/apps/sub2api/resources/redis.env"
        }
      },
      "service_key": "sub2api"
    },
    {
      "container_name": "postgres18-dev",
      "service_key": "postgres"
    },
    {
      "container_name": "redis7-dev",
      "service_key": "redis"
    }
  ],
  "count": 4
