# Repository-local secrets and private credentials.
secrets/

# Environment files stay local; only templates are tracked.
**/.env
**/*.env
!**/.env.example
!templates/**
!**/*.example

# Common secret key and certificate formats.
**/*.pem
**/*.key
**/*.p12
**/*.crt

# Local tool state and caches.
.firecrawl/**
!.firecrawl/.gitkeep
.playwright-cli/
.worktrees/
.workbuddy/
.cache/
.ruff_cache/
.claude/
plans/
tmp/
.omc/

# Python and Node runtime caches.
__pycache__/
*.pyc
.pytest_cache/
.coverage
node_modules/

.venv/

# 本地协作（不纳入开源仓库）
local/

# Local/private control-plane truth retained in this checkout only.
# Keep real host inventories, generated ledgers, and live state out of public Git.
inventory/servers/
inventory/state-snapshot.md

# Maintainer-specific operation runbooks and historical incident notes.
docs/runbooks/prod0-*.md
docs/runbooks/prod2-*.md
docs/runbooks/wsl-secrets-backup.md
docs/runbooks/wsl-zzz-skills-sync.md
docs/archive/runbooks/prod0-*.md
docs/archive/runbooks/prod2-*.md

# Target-rendered compose files and private service variants.
infra/compose/**/docker-compose.prod*.yml
infra/compose/vmail/
infra/compose/relay-trojan/

# Maintainer-specific service env examples.
templates/services/*.prod*.env.example
templates/services/relay-trojan.*.env.example

# Maintainer-specific skills and one-off host repair helpers.
.agents/skills/nginxui-letsencrypt-cloudflare-dns01/
.agents/skills/tencent-*/
.agents/skills/windows-mihomo-cloudflare-latency-debug/
agentplane/cli/prod0_postgres_app_resource_audit.py
agentplane/scripts/probe/probe_tencent_server.sh
agentplane/scripts/remote/remote_prepare_prod0_openresty_host_certs.sh
agentplane/scripts/remote/remote_verify_prod0_openresty_host_certs.sh
